APP_NAME="Sistema Restaurante"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SEED_ADMIN_PASSWORD=
SEED_CASHIER_PIN=
APP_URL=http://localhost

# URL HTTPS del instalador Windows del agente local de impresión, tras compilarlo y publicar su checksum.
PRINT_AGENT_INSTALLER_URL=
PRINT_AGENT_INSTALLER_VERSION=
PRINT_AGENT_INSTALLER_SHA256=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# Integraciones opcionales. Nunca agregar secretos al repositorio.

# Asistente de IA (ver config/asistente.php). Orden de proveedores con respaldo automático:
# groq, openai, gemini, openrouter, ollama, personalizado. Vacío = solo palabras clave.
ASISTENTE_PROVEEDORES=groq
ASISTENTE_STREAMING=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Opcionales (solo si se listan en ASISTENTE_PROVEEDORES):
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OLLAMA_MODEL=
# ASISTENTE_CUSTOM_URL=
# ASISTENTE_CUSTOM_KEY=
# ASISTENTE_CUSTOM_MODEL=
API_PERU_DNI_URL=
API_PERU_RUC_URL=
API_PERU_TOKEN=
API_PERU_AUTH_MODE=bearer
